---
import ArchivePanel from "../../components/ArchivePanel.svelte";
import PostCard from "../../components/PostCard.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

const allPosts = await getSortedPosts();
const categories = ["技术", "踩坑", "指南"];
---

<MainGridLayout>
    <div class="mb-4 flex flex-wrap justify-between items-center gap-2">
        <!-- 左侧：分类筛选按钮 -->
        <div class="flex gap-2 flex-wrap">
            <button
                id="btn-all"
                class="btn-regular px-3 py-1.5 rounded-lg text-sm font-medium"
                style="background: var(--primary); color: white;"
            >
                全部
            </button>
            {categories.map((cat) => (
                <button
                    class="btn-regular px-3 py-1.5 rounded-lg text-sm font-medium category-btn"
                    data-category={cat}
                >
                    {cat}
                </button>
            ))}
        </div>
        <!-- 右侧：视图切换按钮 -->
        <div class="flex gap-2">
            <button
                id="view-archive"
                class="btn-regular px-3 py-1.5 rounded-lg text-sm font-medium"
                style="background: var(--primary); color: white;"
            >
                归档视图
            </button>
            <button
                id="view-list"
                class="btn-regular px-3 py-1.5 rounded-lg text-sm font-medium"
            >
                列表视图
            </button>
        </div>
    </div>

    <div id="archive-view">
        <ArchivePanel
            client:only="svelte"
            tags={[]}
            categories={[]}
            sortedPosts={allPosts}
        />
    </div>

    <div id="list-view" class="hidden">
        <div class="flex flex-col gap-4">
            {allPosts.map((entry, index) => (
                <PostCard
                    entry={entry}
                    style={`animation-delay: ${index * 50}ms;`}
                />
            ))}
        </div>
    </div>
</MainGridLayout>

<script>
    const archiveBtn = document.getElementById("view-archive");
    const listBtn = document.getElementById("view-list");
    const archiveView = document.getElementById("archive-view");
    const listView = document.getElementById("list-view");

    function showArchive() {
        archiveView?.classList.remove("hidden");
        listView?.classList.add("hidden");
        archiveBtn?.setAttribute("style", "background: var(--primary); color: white;");
        listBtn?.removeAttribute("style");
        localStorage.setItem("postsViewMode", "archive");
    }

    function showList() {
        archiveView?.classList.add("hidden");
        listView?.classList.remove("hidden");
        listBtn?.setAttribute("style", "background: var(--primary); color: white;");
        archiveBtn?.removeAttribute("style");
        localStorage.setItem("postsViewMode", "list");
    }

    archiveBtn?.addEventListener("click", showArchive);
    listBtn?.addEventListener("click", showList);

    // Restore saved view mode
    const savedMode = localStorage.getItem("postsViewMode");
    if (savedMode === "list") {
        showList();
    }

    // 分类筛选按钮逻辑
    const categoryBtns = document.querySelectorAll('.category-btn');
    const btnAll = document.getElementById('btn-all');
    const params = new URLSearchParams(window.location.search);
    const activeCategory = params.get('category');
    const activeTag = params.get('tag');
    const activeProject = params.get('project');

    const hasFilter = activeCategory || activeTag || activeProject;

    // 高亮当前激活的分类按钮
    if (hasFilter) {
        // 有筛选时，"全部"不高亮
        btnAll?.removeAttribute('style');
    }

    categoryBtns.forEach(btn => {
        const cat = btn.getAttribute('data-category');
        if (cat === activeCategory) {
            btn.setAttribute('style', 'background: var(--primary); color: white;');
            // 有分类筛选时"全部"不高亮
            btnAll?.removeAttribute('style');
        }

        btn.addEventListener('click', () => {
            window.location.href = '/posts/?category=' + encodeURIComponent(cat!);
        });
    });

    // "全部"按钮：清除所有筛选
    btnAll?.addEventListener('click', () => {
        window.location.href = '/posts/';
    });
</script>
