---
import ArchivePanel from "../../components/ArchivePanel.svelte";
import PostCard from "../../components/PostCard.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

const allPosts = await getSortedPosts();
const categories = ["技术", "踩坑", "指南"];
---

<MainGridLayout>

    <div class="mb-4 flex flex-wrap justify-between items-center gap-2">
        <!-- 左侧：分类筛选按钮 -->
        <div class="flex gap-2 flex-wrap">
            <button
                id="btn-all"
                class="btn-regular px-3 py-1.5 rounded-lg text-sm font-medium"
                style="background: var(--primary); color: white;"
            >
                全部
            </button>
            {categories.map((cat) => (
                <button
                    class="btn-regular px-3 py-1.5 rounded-lg text-sm font-medium category-btn"
                    data-category={cat}
                >
                    {cat}
                </button>
            ))}
        </div>
        <!-- 右侧：视图切换按钮 -->
        <div class="flex gap-2">
            <button
                id="view-archive"
                class="btn-regular px-3 py-1.5 rounded-lg text-sm font-medium"
            >
                归档视图
            </button>
            <button
                id="view-list"
                class="btn-regular px-3 py-1.5 rounded-lg text-sm font-medium"
            >
                列表视图
            </button>
        </div>
    </div>

    <div id="archive-view">
        <ArchivePanel
            client:only="svelte"
            tags={[]}
            categories={[]}
            sortedPosts={allPosts}
        />
    </div>

    <div id="list-view">
        <div class="flex flex-col gap-4">
            {allPosts.map((entry, index) => (
                <div
                    class="list-post-card"
                    data-category={entry.data.category || ""}
                    data-tags={(entry.data.tags || []).join(",")}
                    data-project={(entry.data as any).project || ""}
                >
                    <PostCard
                        entry={entry}
                        style={`animation-delay: ${index * 50}ms;`}
                    />
                </div>
            ))}
        </div>
    </div>
</MainGridLayout>

<script is:inline>
(function() {
    const archiveBtn = document.getElementById("view-archive");
    const listBtn = document.getElementById("view-list");
    const archiveView = document.getElementById("archive-view");
    const listView = document.getElementById("list-view");

    if (!archiveBtn || !listBtn || !archiveView || !listView) return;

    const ACTIVE = "background: var(--primary); color: white;";
    const INACTIVE = "background: transparent; color: inherit;";
    const savedMode = localStorage.getItem("postsViewMode") || "archive";

    // 初始化视图显示和按钮状态
    function initView() {
        if (savedMode === "list") {
            archiveView.style.display = "none";
            listView.style.display = "block";
            listBtn.setAttribute("style", ACTIVE);
            archiveBtn.setAttribute("style", INACTIVE);
            filterListView();
        } else {
            archiveView.style.display = "block";
            listView.style.display = "none";
            archiveBtn.setAttribute("style", ACTIVE);
            listBtn.setAttribute("style", INACTIVE);
        }
    }

    // 切换到归档视图
    function showArchive() {
        archiveView.style.display = "block";
        listView.style.display = "none";
        archiveBtn.setAttribute("style", ACTIVE);
        listBtn.setAttribute("style", INACTIVE);
        localStorage.setItem("postsViewMode", "archive");
    }

    // 切换到列表视图
    function showList() {
        archiveView.style.display = "none";
        listView.style.display = "block";
        listBtn.setAttribute("style", ACTIVE);
        archiveBtn.setAttribute("style", INACTIVE);
        localStorage.setItem("postsViewMode", "list");
        filterListView();
    }

    archiveBtn.addEventListener("click", showArchive);
    listBtn.addEventListener("click", showList);

    // 分类按钮高亮和点击
    const categoryBtns = document.querySelectorAll('.category-btn');
    const btnAll = document.getElementById('btn-all');
    const params = new URLSearchParams(window.location.search);
    const activeCategory = params.get('category');
    const activeTag = params.get('tag');
    const activeProject = params.get('project');
    const hasFilter = activeCategory || activeTag || activeProject;

    if (hasFilter) {
        btnAll?.setAttribute("style", INACTIVE);
    } else {
        btnAll?.setAttribute("style", ACTIVE);
    }

    categoryBtns.forEach(function(btn) {
        var cat = btn.getAttribute('data-category');
        if (cat === activeCategory) {
            btn.setAttribute('style', ACTIVE);
            btnAll?.setAttribute("style", INACTIVE);
        } else {
            btn.setAttribute('style', INACTIVE);
        }
        btn.addEventListener('click', function() {
            window.location.href = '/posts/?category=' + encodeURIComponent(cat);
        });
    });

    btnAll?.addEventListener('click', function() {
        window.location.href = '/posts/';
    });

    // 列表视图筛选
    function filterListView() {
        var cards = document.querySelectorAll('.list-post-card');
        var p = new URLSearchParams(window.location.search);
        var cat = p.get('category');
        var tag = p.get('tag');
        var proj = p.get('project');
        cards.forEach(function(card) {
            var el = card;
            var show = true;
            if (cat && el.dataset.category !== cat) show = false;
            if (tag) {
                var tags = (el.dataset.tags || '').split(',');
                if (!tags.includes(tag)) show = false;
            }
            if (proj && el.dataset.project !== proj) show = false;
            el.style.display = show ? '' : 'none';
        });
    }

    initView();
})();
</script>
