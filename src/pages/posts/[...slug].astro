---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import path from "node:path";
import Comment from "@components/comment/index.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import PasswordProtection from "@components/PasswordProtection.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	// getDir,
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import {
	hasCustomPermalink,
	initPostIdMap,
} from "@utils/permalink-utils";
import { Icon } from "astro-icon/components";
import CryptoJS from "crypto-js";
import { licenseConfig, permalinkConfig, shareConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();

	// 初始化文章 ID 映射（用于 %post_id% 占位符）
	initPostIdMap(blogEntries);

	const paths: {
		params: { slug: string };
		props: { entry: CollectionEntry<"posts"> };
	}[] = [];

	for (const entry of blogEntries) {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const defaultSlug = removeFileExtension(entry.id);

		// 如果文章有自定义 permalink，不在 /posts/ 下创建路径
		// 而是通过根目录的 [permalink].astro 处理
		if (hasCustomPermalink(entry)) {
			// 仍然需要在 /posts/ 下创建默认路径以便兼容旧链接
			paths.push({
				params: { slug: defaultSlug },
				props: { entry },
			});
			continue;
		}

		// 如果全局 permalink 功能启用，不在 /posts/ 下创建路径
		// 而是通过根目录的 [permalink].astro 处理
		if (permalinkConfig.enable) {
			// 仍然保留默认 slug 路径以便兼容旧链接
			paths.push({
				params: { slug: defaultSlug },
				props: { entry },
			});
		} else {
			// 全局 permalink 功能未启用
			// 为每篇文章创建默认的 slug 路径
			paths.push({
				params: { slug: defaultSlug },
				props: { entry },
			});

			// 如果文章有 alias，也创建对应的路径
			if (entry.data.alias) {
				// 移除开头的斜杠和结尾的斜杠
				// 同时移除可能的 "posts/" 前缀，避免重复
				let alias = entry.data.alias
					.replace(/^\/+/, "")
					.replace(/\/+$/, "");
				if (alias.startsWith("posts/")) {
					alias = alias.replace(/^posts\//, "");
				}
				paths.push({
					params: { slug: alias },
					props: { entry },
				});
			}
		}
	}

	return paths;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { remarkPluginFrontmatter } = await render(entry);

// 处理加密逻辑
let encryptedContent = "";
let isEncrypted = entry.data.encrypted && entry.data.password;

if (isEncrypted) {
    // 添加一个固定的前缀用于解密验证
    const contentToEncrypt = "MIZUKI-VERIFY:" + entry.body;

    // 直接使用 CryptoJS 默认的 AES 加密
	encryptedContent = CryptoJS.AES.encrypt(
        contentToEncrypt,
        String(entry.data.password)
    ).toString();
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---

<MainGridLayout
    banner={entry.data.image}
    title={entry.data.title}
    description={entry.data.description}
    lang={entry.data.lang}
    setOGTypeArticle={true}
    postSlug={entry.id}
    headings={headings}
>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- 引入右侧边栏布局管理器 -->
  <script>
    import('../../scripts/right-sidebar-layout.js');
  </script>
    <div
        class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4"
    >
        <div
            id="post-container"
            class:list={[
                "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full !overflow-visible",
                {},
            ]}
        >
            <!-- word count and reading time -->
            <div
                class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation"
            >
                <div class="flex flex-row items-center">
                    <div
                        class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                    >
                        <Icon name="material-symbols:notes-rounded" />
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.words}
                        {" " + i18n(I18nKey.wordsCount)}
                    </div>
                </div>
                <div class="flex flex-row items-center">
                    <div
                        class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                    >
                        <Icon
                            name="material-symbols:schedule-outline-rounded"
                        />
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes}
                        {
                            " " +
                                i18n(
                                    remarkPluginFrontmatter.minutes === 1
                                        ? I18nKey.minuteCount
                                        : I18nKey.minutesCount,
                                )
                        }
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    data-pagefind-body
                    data-pagefind-weight="10"
                    data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]"
                >
                    {entry.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                    className="mb-5"
                    published={entry.data.published}
                    updated={entry.data.updated}
                    tags={entry.data.tags}
                    category={entry.data.category || undefined}
                    id={entry.id}
                />
                {
                    (!entry.data.image|| (entry.data.image && !siteConfig.showCoverInContent)) && (
                        <div class="mt-4 border-[var(--line-divider)] border-dashed border-b-[1px] mb-5" />
                    )
                }
            </div>

            <!-- always show cover as long as it has one -->

            {
                entry.data.image && siteConfig.showCoverInContent && (
                    <>
                        <div class="mt-4" />
                        <ImageWrapper
                            id="post-cover"
                            src={entry.data.image}
                            basePath={getFileDirFromPath(entry.filePath || '')}
                            class="mb-8 rounded-xl banner-container onload-animation"
                        />
                    </>
                )
            }

            {
                isEncrypted ? (
                    <PasswordProtection
                        encryptedContent={encryptedContent}
                    />
                ) : (
                    <>
                        <Markdown class="markdown-content onload-animation">
                            <Content />
                        </Markdown>
                    </>
                )
            }
        </div>
    </div>

    {licenseConfig.enable && (
        <License
            title={entry.data.title}
            id={entry.id}
            pubDate={entry.data.published}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
            class="mb-4 rounded-xl card-base p-6 onload-animation"
        />
    )}

    {shareConfig.enable && (
        <div id="float-share">
            <button id="float-share-btn" class="btn-regular h-10 w-10 rounded-lg flex items-center justify-center shadow-md" aria-label="分享">
                <Icon name="material-symbols:share" class="text-xl" />
            </button>
            <div id="float-share-popup" class="hidden absolute right-0 top-12 bg-[var(--card-bg)] rounded-xl shadow-xl p-3 min-w-[10rem] z-50">
                <button class="float-share-item w-full flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 text-sm transition" data-action="copy">
                    <Icon name="material-symbols:link" class="text-lg" />
                    <span>复制链接</span>
                </button>
                <a class="float-share-item flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 text-sm transition" data-action="weibo" target="_blank" rel="noopener noreferrer">
                    <Icon name="fa6-brands:weibo" class="text-lg" />
                    <span>分享到微博</span>
                </a>
                <a class="float-share-item flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 text-sm transition" data-action="twitter" target="_blank" rel="noopener noreferrer">
                    <Icon name="fa6-brands:x-twitter" class="text-lg" />
                    <span>分享到 X</span>
                </a>
                <a class="float-share-item flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 text-sm transition" data-action="qq" target="_blank" rel="noopener noreferrer">
                    <Icon name="fa6-brands:qq" class="text-lg" />
                    <span>分享到 QQ</span>
                </a>
            </div>
        </div>
    )}

    <!-- 评论 -->
    <Comment post={entry} />

    <div
        class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full"
    >
        <a
            href={entry.data.nextSlug
                ? getPostUrlBySlug(entry.data.nextSlug)
                : "#"}
            class:list={[
                "w-full font-bold overflow-hidden active:scale-95",
                { "pointer-events-none": !entry.data.nextSlug },
            ]}
        >
            {
                entry.data.nextSlug && (
                    <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4">
                        <Icon
                            name="material-symbols:chevron-left-rounded"
                            class="text-[2rem] text-[var(--primary)]"
                        />
                        <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                            {entry.data.nextTitle}
                        </div>
                    </div>
                )
            }
        </a>

        <a
            href={entry.data.prevSlug
                ? getPostUrlBySlug(entry.data.prevSlug)
                : "#"}
            class:list={[
                "w-full font-bold overflow-hidden active:scale-95",
                { "pointer-events-none": !entry.data.prevSlug },
            ]}
        >
            {
                entry.data.prevSlug && (
                    <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                        <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                            {entry.data.prevTitle}
                        </div>
                        <Icon
                            name="material-symbols:chevron-right-rounded"
                            class="text-[2rem] text-[var(--primary)]"
                        />
                    </div>
                )
            }
        </a>
    </div>

    {shareConfig.enable && (
        <style>
            #float-share {
                position: fixed;
                z-index: 45;
            }
            #float-share-popup {
                transition: opacity 0.15s;
            }
        </style>

        <script is:inline>
        (function() {
            var btn = document.getElementById('float-share-btn');
            var popup = document.getElementById('float-share-popup');
            var wrap = document.getElementById('float-share');
            if (!btn || !popup || !wrap) return;

            function positionShare() {
                var container = document.getElementById('post-container');
                if (!container) return;
                var rect = container.getBoundingClientRect();
                wrap.style.left = (rect.right + 8) + 'px';
                wrap.style.top = (rect.top + 8) + 'px';
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', positionShare);
            } else {
                positionShare();
            }
            window.addEventListener('resize', positionShare, { passive: true });

            var url = encodeURIComponent(window.location.href);
            var title = encodeURIComponent(document.title);

            // fill share links
            var items = popup.querySelectorAll('[data-action]');
            items.forEach(function(el) {
                var action = el.getAttribute('data-action');
                if (action === 'weibo') el.href = 'https://service.weibo.com/share/share.php?url=' + url + '&title=' + title;
                if (action === 'twitter') el.href = 'https://twitter.com/intent/tweet?url=' + url + '&text=' + title;
                if (action === 'qq') el.href = 'https://connect.qq.com/widget/shareqq/index.html?url=' + url + '&title=' + title;
            });

            // toggle popup
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                popup.classList.toggle('hidden');
            });
            document.addEventListener('click', function() {
                popup.classList.add('hidden');
            });
            popup.addEventListener('click', function(e) {
                e.stopPropagation();
            });

            // copy link
            var copyBtn = popup.querySelector('[data-action="copy"]');
            if (copyBtn) {
                copyBtn.addEventListener('click', function() {
                    navigator.clipboard.writeText(window.location.href).then(function() {
                        copyBtn.querySelector('span').textContent = '已复制';
                        setTimeout(function() {
                            copyBtn.querySelector('span').textContent = '复制链接';
                        }, 1500);
                    });
                    popup.classList.add('hidden');
                });
            }
        })();
        </script>
    )}
</MainGridLayout>
