---
import { render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import PostMetadata from "@components/PostMeta.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getFileDirFromPath } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";

const allPosts = await getSortedPosts();
const latestPost = allPosts[0];

if (!latestPost) {
    return Astro.redirect("/404/");
}

const { Content, headings } = await render(latestPost);
const { remarkPluginFrontmatter } = await render(latestPost);
---

<MainGridLayout headings={headings}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded" />
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} 字</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded" />
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.minutes} 分钟</div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]">
                    {latestPost.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                    className="mb-5"
                    published={latestPost.data.published}
                    updated={latestPost.data.updated}
                    tags={latestPost.data.tags}
                    category={latestPost.data.category || undefined}
                    id={latestPost.id}
                />
                {(!latestPost.data.image || (latestPost.data.image && !siteConfig.showCoverInContent)) && (
                    <div class="mt-4 border-[var(--line-divider)] border-dashed border-b-[1px] mb-5" />
                )}
            </div>

            <!-- cover image -->
            {latestPost.data.image && siteConfig.showCoverInContent && (
                <>
                    <div class="mt-4" />
                    <ImageWrapper
                        id="post-cover"
                        src={latestPost.data.image}
                        basePath={getFileDirFromPath(latestPost.filePath || '')}
                        class="mb-8 rounded-xl banner-container onload-animation"
                    />
                </>
            )}

            <!-- content -->
            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
