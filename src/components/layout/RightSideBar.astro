---
import type { MarkdownHeading } from "astro";
import SiteStats from "@/components/widget/SiteStats.astro";
import Tags from "@/components/widget/Tags.astro";
import TOC from "@/components/widget/TOC.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const { class: className, headings } = Astro.props;
const hasHeadings = headings && headings.length > 0;
---

<div id="right-sidebar" class:list={[className, "w-full"]}>
  {hasHeadings ? (
    <!-- 文章页：悬浮 TOC（JS 控制 fixed 定位） -->
    <div id="floating-toc-wrapper">
      <TOC headings={headings} />
    </div>
  ) : (
    <!-- 其他页面：只显示站点统计和标签 -->
    <div class="flex flex-col w-full gap-4">
      <SiteStats />
      <Tags />
    </div>
  )}
</div>

<style>
  @media (max-width: 768px) {
    #right-sidebar {
      display: var(--sidebar-mobile-display, block);
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    #right-sidebar {
      display: var(--sidebar-tablet-display, block);
    }
  }

  @media (min-width: 1025px) {
    #right-sidebar {
      display: var(--sidebar-desktop-display, block);
    }
  }
</style>

<script is:inline>
  (function() {
    var wrapper = document.getElementById('floating-toc-wrapper');
    if (!wrapper) return;

    var sidebar = document.getElementById('right-sidebar');
    var origRect = null;
    var isFixed = false;

    function saveRect() {
      if (isFixed) {
        wrapper.style.position = '';
        wrapper.style.top = '';
        wrapper.style.width = '';
        wrapper.style.maxHeight = '';
        wrapper.style.zIndex = '';
        isFixed = false;
      }
      origRect = sidebar.getBoundingClientRect();
    }

    function onScroll() {
      if (!origRect) saveRect();
      if (!origRect) return;

      if (window.scrollY > origRect.top + window.scrollY - 80) {
        if (!isFixed) {
          wrapper.style.position = 'fixed';
          wrapper.style.top = '5rem';
          wrapper.style.width = origRect.width + 'px';
          wrapper.style.maxHeight = 'calc(100vh - 6rem)';
          wrapper.style.overflowY = 'auto';
          wrapper.style.zIndex = '40';
          isFixed = true;
        }
      } else {
        if (isFixed) {
          wrapper.style.position = '';
          wrapper.style.top = '';
          wrapper.style.width = '';
          wrapper.style.maxHeight = '';
          wrapper.style.overflowY = '';
          wrapper.style.zIndex = '';
          isFixed = false;
        }
      }
    }

    saveRect();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function() { saveRect(); onScroll(); });

    if (typeof window !== 'undefined' && window['swup']) {
      window['swup'].hooks.on('content:replace', function() {
        setTimeout(function() { saveRect(); onScroll(); }, 200);
      });
    }
  })();
</script>
