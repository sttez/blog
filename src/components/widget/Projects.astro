---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getProjectList } from "../../utils/content-utils";
import { widgetManager } from "../../utils/widget-manager";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

const projects = await getProjectList();

const COLLAPSED_HEIGHT = "7.5rem";

const projectsComponent = widgetManager
	.getConfig()
	.components.find((c) => c.type === "projects");
const isCollapsed = projectsComponent
	? widgetManager.isCollapsed(projectsComponent, projects.length)
	: false;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name={i18n(I18nKey.projects)} id="projects" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
    {projects.map((p) =>
        <ButtonLink
            url={p.url}
            badge={String(p.count)}
            label={`View all posts in the ${p.name} project`}
        >
            {p.name}
        </ButtonLink>
    )}
</WidgetLayout>
