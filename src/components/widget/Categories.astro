---
import WidgetLayout from "./WidgetLayout.astro";
import ButtonLink from "../control/ButtonLink.astro";

// 固定分类列表，点击跳转到文章页并自动筛选
const categories = [
    { name: "技术", url: "/posts/?category=技术" },
    { name: "踩坑", url: "/posts/?category=踩坑" },
    { name: "指南", url: "/posts/?category=指南" },
];

interface Props {
    class?: string;
    style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name="分类" id="categories" isCollapsed={false}
                class={className} style={style}
>
    {categories.map((c) =>
        <ButtonLink
            url={c.url}
            label={`查看 ${c.name} 分类的文章`}
        >
            {c.name}
        </ButtonLink>
    )}
</WidgetLayout>
